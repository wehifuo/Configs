{
    "position": "top",
    "margin-top": 0,
    "modules-left": [
        "clock",
		  "custom/weather",
        "temperature",
        "hyprland/workspaces"
    ],
    "module-center": [],
    "modules-right": [
		  "custom/spotify",
        "backlight",
        "pulseaudio",
        "network",
        "battery"
    ],
	 "clock": {
		  "format": "{:%I:%M}", 
		  "format-alt": "{:%A, %B %d, %Y (%I:%M)}", 
		  "tooltip-format": "<tt><span size='13pt'>{calendar}</span></tt>"
		  },
	"custom/weather": {
		  "exec": "${HOME}/.config/waybar/scripts/get_weather.sh Minsk",
		  "return-type": "json",
		  "format": "{}",
		  "tooltip": true,
		  "interval": 3600,
		  // "tooltip-format":"<span>{tooltip}</span>"
	 },
    "temperature": {
        "hwmon-path-abs": "/sys/class/hwmon/",
        "input-filename": "temp1_input",
        "hwmon-path-alias": "k10temp",
        "critical-threshold": 80,
        "interval": 2,
        "format": "{temperatureC} °C",
        "tooltip": false
    },
    "hyprland/workspaces": {
        "persistent-workspaces": {
            "*": 5,
            "HDMI-A-1": 3
        }
    },

	 "custom/spotify": {
		  "format": "{}",
		  "escape": true,
		  "return-type": "json",
		  "max-length": 40,
		  "on-click": "playerctl -p spotify play-pause",
		  "on-click-right": "playerctl -p spotify next",
		  "smooth-scrolling-threshold": 10,
		  "on-scroll-up" : "playerctl -p spotify next",
		  "on-scroll-down" : "playerctl -p spotify previous",
		  "exec": "$HOME/.config/waybar/scripts/mediaplayer.py --player spotify 2> /dev/null", // Script in resources/custom_modules folder
		  "exec-if": "pgrep spotify"
	 },

    "backlight": {
        "device": "amdgpu_bl1",
        "format": "{percent}% {icon}",
        "format-icons": [
            "",
            ""
        ],
        "tooltip": false
    },
    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-bluetooth": "{volume}% {icon}",
        "format-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "phone-muted": "",
            "portable": "",
            "car": "",
            "default": [
                " ",
                " "
            ]
        },

        "scroll-step": 1,
        "on-click": "pavucontrol",
        "ignored-sinks": [
            "Easy Effects Sink"
        ]
    },
    "network": {
        "interface": "wlan0",
        "format": "{ifname}",
        "format-wifi": "", //{essid} ({signalStrength}%)
        //"format-ethernet": "{ipaddr}/{cidr} 󰊗",
        "format-disconnected": "",
        "tooltip-format": "{ifname} via {gwaddr} 󰊗",
        "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
        "tooltip-format-ethernet": "{ifname} ",
        "tooltip-format-disconnected": "Disconnected",
        "max-length": 50
    },
    "battery": {
        "interval": 60,
        "states": {
            "warning": 25,
            "critical": 10
        },
        "format": "{capacity}%  {icon}",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ],
        "max-length": 25
    }
}
