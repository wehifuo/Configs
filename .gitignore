# 1. Игнорируем абсолютно всё в текущей директории
/*

# 2. Но не игнорируем сам файл .gitignore
!.gitignore

# 3. Файлы документации в корне
!/README.md
!/KEYMAPS.md

# 4. Делаем исключение для нужных папок (обязательно с косой чертой в конце)
!/nvim/
!/hypr/
!/kitty/
!/tmux/
# TPM-плагины не храним в репозитории
/tmux/plugins/
!/rofi/
!/waybar/
!/yazi/
!/fastfetch/
!/all/
!/assets/
!/control-center/
# Python bytecode не храним
/control-center/__pycache__/
/control-center/cc/__pycache__/
